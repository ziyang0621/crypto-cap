{
  "expo": {
    "name": "crypto-cap",
    "description": "a cryptocurrency price tracking app",
    "slug": "crypto-cap",
    "privacy": "public",
    "version": "1.1.0",
    "orientation": "portrait",
    "primaryColor": "#cccccc",
    "icon": "./assets/icons/app-icon.png",
    "splash": {
      "image": "./assets/icons/loading-icon.png",
      "backgroundColor": "#045076",
      "resizeMode": "contain"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "com.ziyang0621.cryptocap",
      "supportsTablet": true,
      "buildNumber": "9"
    },
    "android": {
      "package": "com.ziyang00621.cryptocap",
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/app-icon.png",
        "backgroundColor": "#045076"
      }
    },
    "androidStatusBar": {
      "backgroundColor": "#031622"
    }
  }
}
